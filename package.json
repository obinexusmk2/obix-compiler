{
  "name": "@obinexusltd/obix-compiler",
  "version": "0.2.1",
  "description": "The OBIX compiler: source -> sections -> AST -> semantic AST -> canonical DOP IR -> ES6 emit. Accessibility analysis is a HARD dependency; there is no --no-a11y mode.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@obinexusltd/obix-spec": "0.2.1",
    "@obinexusltd/obix-ir": "0.2.1",
    "@obinexusltd/obix-parser": "0.2.1",
    "@obinexusltd/obix-template": "0.2.1",
    "@obinexusltd/obix-styles": "0.2.1",
    "@obinexusltd/obix-accessibility": "0.2.1",
    "@obinexusltd/obix-validator": "0.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexusmk2/obix-monorepo-2026.git",
    "directory": "packages/obix-compiler"
  }
}
